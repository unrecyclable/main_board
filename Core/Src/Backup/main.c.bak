typedef struct{
	float kp;
	float ki;
	float kd;
	float last;
	float integrate;
}PID;



float pid_control(PID*pid,float delta)
{
	float out;
	//float max=10000;
	pid->integrate+=delta;
//	if(pid->integrate>max)
//	{
//		pid->integrate=max;
//	}
//	else if(pid->integrate<-max)
//		pid->integrate=-max;
	if(fabs(pid->integrate)<5)
		pid->integrate=0;
	if(delta*pid->last<0)
		pid->integrate=0;
	out=delta*pid->kp+(delta-pid->last)*pid->kd+pid->ki*pid->integrate;
	pid->last=delta;
	
	return out;
	
	
}

PID ipid={.kp=0.8,.ki=0.05,.kd=0};
PID vpid={.kp=0.02,.ki=0.0001,.kd=0.0001};//<-这一版相对不错 要配合1ms控制频率使用//PID vpid={.kp=0.004,.ki=0.001,.kd=0};
PID ipid1={.kp=1,.ki=0.01,.kd=0.1};
PID vpid1={.kp=0.02,.ki=0.0001,.kd=0.0001};
PID ppid={.kp=2,.ki=0.1,.kd=0};
uint32_t mailbox=0;
float motor_i[4];

void can_motor_init()
{
	CAN_FilterTypeDef filter;
	filter.FilterActivation=ENABLE;
	filter.FilterBank=1;
	filter.FilterFIFOAssignment=CAN_FilterFIFO0;
	filter.FilterIdHigh=0;
	filter.FilterIdLow=0;
	filter.FilterMaskIdHigh=0;
	filter.FilterMaskIdLow=0;
	filter.FilterMode=CAN_FILTERMODE_IDMASK;
	filter.FilterScale=CAN_FILTERSCALE_32BIT;
	HAL_CAN_ConfigFilter(&hcan1,&filter);
	HAL_CAN_ActivateNotification(&hcan1,CAN_IT_RX_FIFO0_MSG_PENDING);
	HAL_CAN_Start(&hcan1);
	
}
void can_motor_set_i()
{
	CAN_TxHeaderTypeDef tx;
	tx.DLC=8;
	tx.ExtId=0x200;
	tx.StdId=0x200;
	tx.RTR=CAN_RTR_DATA;
	tx.IDE=CAN_ID_STD;
	uint8_t temp[8];
	
	for(int i=0;i<4;i++)
	{
		temp[i*2]=(int16_t)(motor_i[i]/20*16384)>>8;
		temp[i*2+1]=(int16_t)(motor_i[i]/20*16384)&0xff;
		//temp[i]=0x01;
		//temp[i+1]=0x00;
	} 
	HAL_CAN_AddTxMessage(&hcan1,&tx,temp,&mailbox);
}
void can_send(uint16_t id,uint8_t*data,int len)
{

	CAN_TxHeaderTypeDef tx;
	tx.DLC=len;
	tx.ExtId=id;
	tx.StdId=id;
	tx.RTR=CAN_RTR_DATA;
	tx.IDE=CAN_ID_STD;

	HAL_CAN_AddTxMessage(&hcan1,&tx,data,&mailbox);

}
typedef struct
{
	uint16_t id;
	uint8_t data[8];
	uint8_t flag;
}c620_rawdata;
typedef struct
{
	uint16_t id;
	float angle;
	float rate;
	float i;
	float tempature;
	uint8_t flag;
}c620_msg;
c620_rawdata motor_data;
c620_msg motor_msg;
c620_msg motor_msg1;
void HAL_CAN_RxFifo0MsgPendingCallback(CAN_HandleTypeDef *hcan)
{if(hcan->Instance==CAN1)
	{
		motor_data.flag=1;
		CAN_RxHeaderTypeDef rx;
		uint8_t data[8];
		HAL_CAN_GetRxMessage(&hcan1,CAN_RX_FIFO0,&rx,data);
		if(rx.StdId==0x201)
		{motor_msg.angle=(float)(data[0]<<8|data[1])/8191*360;
		motor_msg.rate=(float)(int16_t)(data[2 ]<<8|data[3]);
		motor_msg.i=(float)((int16_t)(data[4]<<8|data[5]))/16384*20;
		motor_msg.tempature=(float)(int16_t)data[6];
		motor_msg.id=rx.StdId;
		}
		if(rx.StdId==0x203)
		{motor_msg1.angle=(float)(data[0]<<8|data[1])/8191*360;
		motor_msg1.rate=(float)(int16_t)(data[2 ]<<8|data[3]);
		motor_msg1.i=(float)((int16_t)(data[4]<<8|data[5]))/16384*20;
		motor_msg1.tempature=(float)(int16_t)data[6];
		motor_msg1.id=rx.StdId;
		}
		//printf("%f\n",motor_msg.i);
	} 
}

void key_init()
{

HAL_GPIO_WritePin(GPIOA,GPIO_PIN_6,GPIO_PIN_RESET);
HAL_GPIO_WritePin(GPIOA,GPIO_PIN_3,GPIO_PIN_RESET);


}
int get_key()
{
if((!HAL_GPIO_ReadPin(GPIOA,GPIO_PIN_7))||(!HAL_GPIO_ReadPin(GPIOB,GPIO_PIN_0)))
return 1;
else if((!HAL_GPIO_ReadPin(GPIOA,GPIO_PIN_2))||(!HAL_GPIO_ReadPin(GPIOB,GPIO_PIN_3)))
return 2;
else 
return 0;
}
void motor_task()
{
	can_motor_init();
	key_init();
	float overflag=0;
	float max=15;
  while(1)
  {
	float target1=-2400;
  float target0=-480;  
  float itar0,itar1;
  float out0;
  float out1;
	int key=get_key();
float tari=1.0;
		float tar_pos=90;
if(key==1)
  {
		if(overflag==0)
		{
			//float outp=pid_control(&ppid,tar_pos-motor_msg.angle);
			out0=pid_control(&vpid,target0-motor_msg.rate);
		if(out0>max)
			out0=max;
		if(out0<-max)
			out0=-max;
		//out0=pid_control(&ipid,tari-motor_msg.i);
			motor_i[0]=out0;
			
			if(fabs(motor_msg.i)>19)
			{overflag=1;
				motor_i[0]=0;
			}
		
		}
	can_motor_set_i();

}
else if(key==2)
  {
		if(overflag==0)
		{
 out1=pid_control(&vpid1,target1-motor_msg1.rate);
		if(out1>max)
			out1=max;
		if(out1<-max)
			out1=-max;
		
		motor_i[2]=out1;
	can_motor_set_i();
  }
}
  else{
		overflag=0;
	//float o1,o0;
  //o1=pid_control(&vpid1,-motor_msg1.i);
  //o0=pid_control(&vpid0,-motor_msg.i);
  //motor_i[0]=o0;
	//motor_i[2]=o1;
    	//printf("%f,%f\n",o1,o0);
	//	can_motor_set_i();
		motor_i[0]=0;
		motor_i[2]=0;
		can_motor_set_i();
  }
//printf("%f,%f,%f,%f\n",motor_msg.i,motor_msg.rate,motor_msg.angle,out0);

	vTaskDelay(pdMS_TO_TICKS(1));
}

}
	#define uart5rxsize 64
