int uart5parse(uint8_t*data,int len)
{
int p=0;
int ch;
while(p<len)
{
ch=data[p];
if(data[p]==0xac)
{
  if(data[p+1]==0xbc)
  {
    return 0;

  }
}
p++;

}
return 1;

}
